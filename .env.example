# 复制为 .env 后填写。这里只放占位符，永远不要把真实密钥写进本文件。
# 占位符（含 your- / placeholder / change-me）会被视为"未配置"。

# ===== 基础配置（必填） =====
NODE_ENV=development
# 随机长字符串，可用：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/teachai
BASE_URL=http://localhost:3000

# ===== AI 服务（至少配置一个） =====
# 硅基流动（默认批改模型 Qwen/Qwen3.6-35B-A3B）
SILICONCLOUD_API_KEY=your-siliconcloud-key
# 阿里云百炼（qwen-vl-max）
ALIBABA_BAILIAN_API_KEY=your-bailian-key
# OpenAI（可选，配置后可选用 gpt-4o）
OPENAI_API_KEY=

# AI 费用控制（可选，括号内为默认值）
# 单个账号每天最多发起的 AI 批改/分析次数（200）
AI_DAILY_LIMIT_PER_USER=200
# 单次 AI 调用最多生成的 token 数（4096）
AI_MAX_OUTPUT_TOKENS=4096

# ===== 阿里云 OSS（上传作业图片、导出报告时需要） =====
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your-bucket-name
OSS_REGION=oss-cn-hangzhou

# ===== PDF 导出（可选） =====
# 本机 Chrome / Edge 的可执行文件路径；不填时自动查找常见安装位置
PDF_BROWSER_PATH=

# ===== 部署 =====
# 部署在 Nginx 等反向代理之后时设为 true，才会信任 X-Forwarded-For 识别客户端 IP
TRUST_PROXY=false

# ===== 注册控制 =====
# true：任何人都能注册教师账号；否则必须使用邀请码（pnpm codes create 生成）
ALLOW_REGISTRATION=false
